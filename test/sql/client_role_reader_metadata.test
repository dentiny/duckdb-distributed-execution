# name: test/sql/client_role_reader_metadata.test
# description: read-only attachments discover remote table metadata created by the writer
# group: [sql]

# FIXME: Duckherder keeps table metadata only in the attachment-local DuckCatalog.
# A fresh read-only attachment therefore cannot bind a table that already exists
# on the control node. Enable this regression after remote catalog discovery lands.
mode skip

require duckherder

statement ok
SELECT duckherder_start_local_server(8838);

statement ok
ATTACH ':memory:' AS dh
  (TYPE duckherder, client_role 'read_write', server_host 'localhost', server_port 8838);

statement ok
PRAGMA duckherder_register_remote_table('reader_visible_data', 'reader_visible_data');

statement ok
CREATE TABLE dh.reader_visible_data (id INTEGER);

statement ok
INSERT INTO dh.reader_visible_data VALUES (42);

statement ok
DETACH dh;

statement ok con1
ATTACH ':memory:' AS dh
  (TYPE duckherder, client_role 'read_only', server_host 'localhost', server_port 8838);

statement ok con1
PRAGMA duckherder_register_remote_table('reader_visible_data', 'reader_visible_data');

query I con1
SELECT * FROM dh.reader_visible_data;
----
42
