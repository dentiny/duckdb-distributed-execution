# name: test/sql/query_pushdown.test
# description: Queries reading only remote tables run on the server as a whole, unless they depend on client state
# group: [sql]

require duckherder

require duckdb_object_storage

statement ok
SELECT duckherder_start_local_server(8871, 2);

statement ok
ATTACH 'localhost:8871' AS dh (TYPE duckherder);

statement ok
CREATE TABLE dh.orders (id INTEGER, customer_id INTEGER, amount INTEGER, ts TIMESTAMPTZ);

statement ok
INSERT INTO dh.orders
SELECT i, i % 10, i, to_timestamp(1704067200 + i * 3600) FROM range(100) t(i);

statement ok
CREATE TABLE dh.customers (id INTEGER, name VARCHAR);

statement ok
INSERT INTO dh.customers SELECT i, 'c' || i FROM range(10) t(i);

# Each query carries a marker alias, which only appears in server stats if the whole query was pushed down.
query II
SELECT c.name AS pushed_join, sum(o.amount) FROM dh.orders o JOIN dh.customers c ON o.customer_id = c.id
GROUP BY c.name ORDER BY c.name LIMIT 2;
----
c0	450
c1	460

query I
SELECT count(*) FROM duckherder_get_query_execution_stats() WHERE sql LIKE '%pushed_join%JOIN%';
----
1

# CTE names stay unqualified, so the server resolves them to the same CTE.
query I
WITH big AS (SELECT * FROM dh.orders WHERE amount >= 90) SELECT count(*) AS pushed_cte FROM big;
----
10

query I
SELECT count(*) FROM duckherder_get_query_execution_stats() WHERE sql LIKE '%pushed_cte%';
----
1

# The server returns a large ordered result in many batches, which the client keeps in order.
statement ok
CREATE TABLE dh.numbers AS SELECT i FROM range(100000) t(i);

query I
SELECT i AS pushed_order FROM dh.numbers ORDER BY i DESC;
----
100000 values hashing to 6a720b227e361303445c41f7ff4a8109

# Queries depending on client state stay on the client.
statement ok
CREATE TABLE local_ids AS SELECT 1 AS id;

query I
SELECT count(*) AS local_join FROM dh.orders o JOIN local_ids l ON o.id = l.id;
----
1

statement ok
CREATE VIEW big_orders AS SELECT * FROM dh.orders WHERE amount >= 90;

query I
SELECT count(*) AS view_query FROM big_orders;
----
10

statement ok
CREATE TEMP MACRO double_it(x) AS x * 2;

query I
SELECT max(double_it(amount)) AS macro_query FROM dh.orders;
----
198

statement ok
PREPARE param_query AS SELECT count(*) AS param_query FROM dh.orders WHERE id < $1;

query I
EXECUTE param_query(5);
----
5

# The client's TimeZone, which the server lacks, decides how a TIMESTAMPTZ literal is read.
query I
SELECT count(*) AS tz_query FROM dh.orders WHERE ts < TIMESTAMPTZ '2024-01-02 00:00:00+00';
----
24

statement ok
SET default_null_order = 'nulls_first';

query I
SELECT count(*) AS setting_query FROM dh.orders;
----
100

statement ok
RESET default_null_order;

statement ok
SET old_implicit_casting = true;

query I
SELECT count(*) AS implicit_cast_query FROM dh.orders;
----
100

statement ok
RESET old_implicit_casting;

statement ok
SET order_by_non_integer_literal = true;

query I
SELECT count(*) AS literal_order_query FROM dh.orders;
----
100

statement ok
RESET order_by_non_integer_literal;

statement ok
CREATE SEQUENCE local_seq;

query I
SELECT max(nextval('local_seq')) AS sequence_query FROM dh.customers;
----
10

statement ok
CREATE TYPE local_mood AS ENUM ('a', 'b');

query I
SELECT count(*) AS type_query FROM dh.customers WHERE TRY_CAST(name AS local_mood) IS NULL;
----
10

query I
SELECT count(*) FROM duckherder_get_query_execution_stats()
WHERE sql SIMILAR TO
    '.*(local_join|view_query|macro_query|param_query|tz_query|setting_query|implicit_cast_query|literal_order_query|sequence_query|type_query).*';
----
0

# Expressions over client state that evaluate to a constant are folded on the client, so their queries still run on
# the server.
statement ok
SET VARIABLE min_amount = 95;

query I
SELECT count(*) AS pushed_variable FROM dh.orders WHERE amount >= getvariable('min_amount');
----
5

query I
SELECT count(*) AS pushed_local_type FROM dh.customers WHERE 'a'::local_mood = 'a';
----
10

query I
SELECT dh.orders.id AS pushed_qualified FROM dh.orders WHERE id = 1;
----
1

# Passing a TIMESTAMPTZ column through does not depend on the time zone.
query I
SELECT count(*) FROM (SELECT ts AS pushed_tz_passthrough FROM dh.orders);
----
100

query I
SELECT count(*) FROM duckherder_get_query_execution_stats()
WHERE sql SIMILAR TO '.*(pushed_variable|pushed_local_type|pushed_qualified|pushed_tz_passthrough).*';
----
4

# Parts of a query that only read remote tables run on the server, even when the rest of the query stays local.
query I
SELECT count(*) FROM (SELECT id AS pushed_union_child FROM dh.customers UNION ALL SELECT id FROM local_ids);
----
11

statement ok
CREATE TABLE local_copy AS SELECT id AS pushed_ctas FROM dh.customers WHERE id < 3;

statement ok
INSERT INTO local_copy SELECT id AS pushed_insert_select FROM dh.customers WHERE id = 5;

query I
SELECT pushed_ctas FROM local_copy ORDER BY ALL;
----
0
1
2
5

query I
SELECT count(*) FROM duckherder_get_query_execution_stats()
WHERE sql SIMILAR TO '.*(pushed_union_child|pushed_ctas|pushed_insert_select).*';
----
3

# Unqualified tables resolve through the client's search path, not the server's default schema.
statement ok
CREATE SCHEMA dh.other;

statement ok
CREATE TABLE dh.other.orders AS SELECT 1 AS id;

statement ok
USE dh.other;

query I
SELECT count(*) AS pushed_search_path FROM orders;
----
1

statement ok
USE memory;

query I
SELECT count(*) FROM duckherder_get_query_execution_stats() WHERE sql LIKE '%pushed_search_path%other.orders%';
----
1

# duckherder_query runs a query on the server directly.
query I
SELECT * FROM duckherder_query('dh', 'SELECT count(*) AS direct_query FROM orders');
----
100

statement error
SELECT * FROM duckherder_query('memory', 'SELECT 1');
----
requires a Duckherder database

statement error
SELECT * FROM duckherder_query('dh', 'DELETE FROM orders');
----
requires a single SELECT query

# Built-in types resolve the same on the server, even when the remote database is the default one.
statement ok
USE dh;

query I
SELECT count(*) AS pushed_cast FROM orders WHERE id < CAST(5 AS BIGINT);
----
5

statement ok
USE memory;

query I
SELECT count(*) FROM duckherder_get_query_execution_stats() WHERE sql LIKE '%pushed_cast%';
----
1

# SUMMARIZE names its table without a table reference, so it stays on the client.
statement ok
SUMMARIZE dh.customers;

statement ok
DETACH dh;

statement ok
SELECT duckherder_stop_local_server();
