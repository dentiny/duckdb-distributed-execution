# name: test/sql/worker_fragment_catalog.test
# description: Worker fragments preserve catalog identity and reject other attachments
# group: [sql]

require duckherder

require duckdb_object_storage

statement ok
SET GLOBAL duckdb_objfs_backend = 'local';

statement ok
SET GLOBAL duckdb_objfs_root = '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}';

statement ok
ATTACH 'duckdb_objfs://fragment_catalog.db' AS object_db;

statement ok
USE object_db;

statement ok
CREATE TABLE fact AS SELECT i AS id, i % 2 AS k, 2 AS amount FROM range(300000) t(i);

statement ok
CREATE TABLE dim AS SELECT i AS k, 5 AS multiplier FROM range(2) t(i);

# Same table names, different data in another catalog.
statement ok
ATTACH ':memory:' AS "other catalog";

statement ok
CREATE TABLE "other catalog".main.fact AS SELECT i AS id, i % 2 AS k, 3 AS amount FROM range(300000) t(i);

statement ok
CREATE TABLE "other catalog".main.dim AS SELECT i AS k, 7 AS multiplier FROM range(2) t(i);

# Run the driver optimizer here so SQL can create and query its attachments.
statement ok
SELECT duckherder_test_enable_worker_fragments('duckdb_objfs://fragment_catalog.db', 2);

statement ok
USE "other catalog";

# Foreign joins, aggregates, scans and mixed joins keep their bound catalog.
query I
SELECT sum(f.amount * d.multiplier) FROM fact f JOIN dim d ON f.k = d.k;
----
6300000

query I
SELECT sum(amount) FROM fact;
----
900000

query I
SELECT amount FROM fact WHERE id = 1;
----
3

query I
SELECT sum(f.amount * d.multiplier) FROM fact f JOIN object_db.main.dim d ON f.k = d.k;
----
4500000

query I
SELECT sum(f.amount * d.multiplier) FROM object_db.main.fact f JOIN dim d ON f.k = d.k;
----
4200000

# None of the foreign-catalog queries should generate a worker fragment.
query I
SELECT count(*) FROM duckherder_test_worker_fragments();
----
0

# The served catalog still partitions, even after USE changed the client's default.
query I
SELECT sum(f.amount * d.multiplier) FROM object_db.main.fact f JOIN object_db.main.dim d ON f.k = d.k;
----
3000000

query III
SELECT sql LIKE '%object_db.main.fact%' AND sql LIKE '%object_db.main.dim%', partitioned, num_tasks_generated
FROM duckherder_test_worker_fragments();
----
true	true	2

statement ok
SELECT duckherder_test_disable_worker_fragments();

statement ok
USE memory;

statement ok
DETACH "other catalog";

statement ok
DETACH object_db;
