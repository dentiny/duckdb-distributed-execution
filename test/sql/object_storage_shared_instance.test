# name: test/sql/object_storage_shared_instance.test
# description: Clients of one ObjFS database share its control node instance, so readers see the writer's commits
# group: [sql]

require duckherder

require duckdb_object_storage

# Without workers every query runs on the control node.
statement ok
SELECT duckherder_start_local_server(8841);

statement ok
ATTACH 'localhost:8841/shared.db' AS writer (TYPE duckherder, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok
CREATE OR REPLACE TABLE writer.items (id INTEGER);

statement ok
INSERT INTO writer.items VALUES (1);

statement ok
DETACH writer;

# A reader attached before the writer still sees the writer's commits.
statement ok con1
ATTACH 'localhost:8841/shared.db' AS reader (TYPE duckherder, READ_ONLY, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

query I con1
SELECT sum(id) FROM reader.items;
----
1

statement ok
ATTACH 'localhost:8841/shared.db' AS writer (TYPE duckherder, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok
INSERT INTO writer.items VALUES (2);

query I con1
SELECT sum(id) FROM reader.items;
----
3

statement error con1
INSERT INTO reader.items VALUES (4);
----
<REGEX>:.*read-only.*

# The next writer joins the instance the reader is on.
statement ok
DETACH writer;

statement ok con2
ATTACH 'localhost:8841/shared.db' AS writer (TYPE duckherder, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok con2
INSERT INTO writer.items VALUES (8);

query I con1
SELECT sum(id) FROM reader.items;
----
11

statement ok
SELECT duckherder_stop_local_server();
