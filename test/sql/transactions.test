# name: test/sql/transactions.test
# description: Transaction control is forwarded to the client's control-node connection
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8839);

statement ok
ATTACH DATABASE 'localhost:8839' AS dh (TYPE duckherder, client_role 'read_write');

statement ok
CREATE TABLE dh.transaction_test (id INTEGER);

statement ok
INSERT INTO dh.transaction_test VALUES (1);

statement ok
BEGIN;

statement ok
INSERT INTO dh.transaction_test VALUES (2);

# The client's control-node connection sees its own uncommitted write.
query I
SELECT id FROM dh.transaction_test ORDER BY id;
----
1
2

statement ok
ROLLBACK;

query I
SELECT id FROM dh.transaction_test ORDER BY id;
----
1

statement ok
BEGIN;

statement ok
INSERT INTO dh.transaction_test VALUES (3);

statement ok
COMMIT;

query I
SELECT id FROM dh.transaction_test ORDER BY id;
----
1
3

# Preserve the remote exception type and message when COMMIT fails.
statement ok
CREATE TABLE dh.commit_constraint_error (id INTEGER, key INTEGER);

statement ok
BEGIN;

statement ok
INSERT INTO dh.commit_constraint_error VALUES (1, 1);

statement ok
ALTER TABLE dh.commit_constraint_error ADD PRIMARY KEY (key);

statement ok
INSERT INTO dh.commit_constraint_error VALUES (2, 1);

statement error
COMMIT;
----
<REGEX>:TransactionContext Error.*Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key "1".*

# The failed remote transaction was rolled back, including its new constraint.
statement ok
INSERT INTO dh.commit_constraint_error VALUES (1, 1), (2, 1);
