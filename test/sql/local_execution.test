# name: test/sql/local_execution.test
# description: Test local execution mode for queries that cannot be distributed
# group: [sql]

require duckherder

require duckdb_object_storage

# Start distributed server with 2 workers
statement ok
SELECT duckherder_start_local_server(8829, 2);

statement ok
ATTACH DATABASE 'localhost:8829/database.db' AS dh (TYPE duckherder, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok
USE dh;

statement ok
CREATE TABLE local_test (id INTEGER, value VARCHAR, amount INTEGER);

statement ok
INSERT INTO local_test VALUES
    (1, 'apple', 100),
    (2, 'banana', 200),
    (3, 'cherry', 300),
    (4, 'date', 400),
    (5, 'elderberry', 500);

statement ok
USE memory;

statement ok
DETACH dh;

statement ok
ATTACH DATABASE 'localhost:8829/database.db' AS dh (TYPE duckherder, READ_ONLY, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok
USE dh;

# Query with ORDER BY, which cannot be distributed, should execute locally on the driver node.
query III
SELECT id, value, amount FROM local_test ORDER BY id;
----
1	apple	100
2	banana	200
3	cherry	300
4	date	400
5	elderberry	500

# Query with ORDER BY DESC, which also executes on driver node locally.
query III
SELECT id, value, amount FROM local_test ORDER BY amount DESC;
----
5	elderberry	500
4	date	400
3	cherry	300
2	banana	200
1	apple	100

# Verify execution mode.
# Queries with ORDER BY cannot be distributed, so they should use LOCAL mode.
# However, if the table is small, they might use DELEGATED mode instead.
query I
SELECT EXISTS(SELECT 1 FROM duckherder_get_query_execution_stats() 
              WHERE sql LIKE '%local_test%' AND (execution_mode = 'LOCAL' OR execution_mode = 'DELEGATED'));
----
true
