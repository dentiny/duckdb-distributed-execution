# name: test/sql/alter_table_add_column.test
# description: ADD COLUMN executes on the control node and updates the client catalog
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8842);

statement ok
ATTACH DATABASE 'localhost:8842' AS dh (TYPE duckherder, client_role 'read_write');

statement ok
CREATE TABLE dh.add_column_test (id INTEGER, name VARCHAR);

statement ok
INSERT INTO dh.add_column_test VALUES (1, 'one'), (2, 'two');

statement ok
ALTER TABLE dh.add_column_test ADD COLUMN score INTEGER DEFAULT 10;

statement ok
UPDATE dh.add_column_test SET score = 20 WHERE id = 2;

query ITI
SELECT id, name, score FROM dh.add_column_test ORDER BY id;
----
1	one	10
2	two	20
