# name: test/sql/create_macro.test
# description: Scalar and table macros execute on the control node in subsequent remote DML
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8846);

statement ok
ATTACH DATABASE 'localhost:8846' AS dh (TYPE duckherder, client_role 'read_write');

statement ok
CREATE TABLE dh.macro_result (value INTEGER);

statement ok
CREATE MACRO dh.add_one(value) AS value + 1;

statement ok
INSERT INTO dh.macro_result SELECT dh.add_one(41);

statement ok
CREATE MACRO dh.generate_rows(first_value) AS TABLE
    SELECT first_value AS value
    UNION ALL
    SELECT first_value + 1 AS value;

statement ok
INSERT INTO dh.macro_result SELECT value FROM dh.generate_rows(50);

query I
SELECT value FROM dh.macro_result ORDER BY value;
----
42
50
51
