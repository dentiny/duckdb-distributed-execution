# name: test/sql/distributed_result_types.test
# description: Worker result batches are forwarded to the client for every column type without falling back to local execution
# group: [sql]

require duckherder

require duckdb_object_storage

statement ok
SELECT duckherder_start_local_server(8866, 2);

statement ok
ATTACH 'localhost:8866/types.db' AS dh (TYPE duckherder, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok
CREATE TYPE dh.mood AS ENUM ('sad', 'ok', 'happy');

# 250,000 rows span multiple row groups, so scans are partitioned across workers.
statement ok
CREATE TABLE dh.typed AS
SELECT
    i AS id,
    CASE WHEN i % 10 = 0 THEN NULL ELSE 'v' || i END AS str,
    (['sad', 'ok', 'happy'])[i % 3 + 1]::dh.mood AS feeling,
    (i / 100)::DECIMAL(18, 2) AS amount,
    i::HUGEINT * 1000000000000 AS big,
    TIMESTAMP '2024-01-01' + INTERVAL (i) SECOND AS ts,
    DATE '2024-01-01' + (i % 365)::INTEGER AS day,
    [i, i + 1] AS pair,
    {'a': i, 'b': 's' || i} AS rec,
    ('b' || (i % 10)::VARCHAR)::BLOB AS bytes,
    '00000000-0000-4000-8000-000000000000'::UUID AS uid
FROM range(250000) t(i);

statement ok
DETACH dh;

statement ok
ATTACH 'localhost:8866/types.db' AS dh (TYPE duckherder, READ_ONLY, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

query IIIIIIIIIII
SELECT id, str, feeling, amount, big, ts, day, pair, rec, bytes, uid FROM dh.typed WHERE id = 249997;
----
249997	v249997	ok	2499.97	249997000000000000	2024-01-03 21:26:37	2024-12-03	[249997, 249998]	{'a': 249997, 'b': s249997}	b7	00000000-0000-4000-8000-000000000000

query IIIIII
SELECT count(*), count(str), count(DISTINCT feeling), sum(amount), max(big), max(ts) FROM dh.typed;
----
250000	225000	3	312498750.00	249999000000000000	2024-01-03 21:26:39

query III
SELECT sum(pair[2]), count(DISTINCT rec.b), count(DISTINCT bytes) FROM dh.typed;
----
31250125000	250000	10

# Every scan was partitioned across workers; a schema mismatch would have fallen back to LOCAL.
query I
SELECT count(*) FROM duckherder_get_query_execution_stats() WHERE sql LIKE '%typed%' AND execution_mode <> 'ROW_GROUP_PARTITION';
----
0

query I
SELECT count(*) > 0 FROM duckherder_get_query_execution_stats() WHERE sql LIKE '%typed%' AND execution_mode = 'ROW_GROUP_PARTITION';
----
true

statement ok
DETACH dh;

statement ok
SELECT duckherder_stop_local_server();
