# name: test/sql/prepared_dml.test
# description: Prepared DML stores and executes the complete inner statement on the control node
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8847);

statement ok
ATTACH DATABASE 'localhost:8847' AS dh (TYPE duckherder, client_role 'read_write');

statement ok
CREATE TABLE dh.prepared_dml (id INTEGER, value VARCHAR);

statement ok
INSERT INTO dh.prepared_dml VALUES (1, 'one'), (2, 'two');

statement ok
PREPARE prepared_insert AS
    INSERT INTO dh.prepared_dml VALUES (3, 'three');

query I
SELECT COUNT(*) FROM dh.prepared_dml;
----
2

statement ok
PREPARE prepared_null_insert AS
    INSERT INTO dh.prepared_dml VALUES (0, $1);

statement ok
EXECUTE prepared_null_insert(NULL);

query I
SELECT value FROM dh.prepared_dml WHERE id = 0;
----
NULL

statement ok
DELETE FROM dh.prepared_dml WHERE id = 0;

statement ok
EXECUTE prepared_insert;

statement ok
PREPARE prepared_update AS
    UPDATE dh.prepared_dml SET value = upper(value) WHERE id = 2;

statement ok
EXECUTE prepared_update;

statement ok
PREPARE prepared_delete AS
    DELETE FROM dh.prepared_dml WHERE id = 1;

statement ok
EXECUTE prepared_delete;

query II
SELECT id, value FROM dh.prepared_dml ORDER BY id;
----
2	TWO
3	three

statement ok
PREPARE parameterized_insert AS
    INSERT INTO dh.prepared_dml VALUES ($1, $2);

statement ok
EXECUTE parameterized_insert(4, 'four');

statement ok
PREPARE parameterized_update AS
    UPDATE dh.prepared_dml SET value = $1 WHERE id = $2;

statement ok
EXECUTE parameterized_update('FOUR', 4);

statement ok
PREPARE parameterized_delete AS
    DELETE FROM dh.prepared_dml WHERE id = $1;

statement ok
EXECUTE parameterized_delete(3);

query II
SELECT id, value FROM dh.prepared_dml ORDER BY id;
----
2	TWO
4	FOUR

# Prepared RETURNING expressions are evaluated once on the client.
statement ok
PREPARE parameterized_insert_returning AS
    INSERT INTO dh.prepared_dml VALUES ($1, $2) RETURNING id + 10, value || '!';

query IT
EXECUTE parameterized_insert_returning(1, 'one');
----
11	one!

statement ok
PREPARE parameterized_update_returning AS
    UPDATE dh.prepared_dml SET value = $1 WHERE id = $2 RETURNING id + 10, value || '!';

query IT
EXECUTE parameterized_update_returning('uno', 1);
----
11	uno!

statement ok
PREPARE parameterized_delete_returning AS
    DELETE FROM dh.prepared_dml WHERE id = $1 RETURNING id + 10, value || '!';

query IT
EXECUTE parameterized_delete_returning(1);
----
11	uno!

query II
SELECT id, value FROM dh.prepared_dml ORDER BY id;
----
2	TWO
4	FOUR
