# name: test/sql/client_connection_sessions.test
# description: each DuckDB connection owns an independent Flight registration
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8843);

query I
SELECT duckherder_get_client_count();
----
0

# A read-write attachment belongs exclusively to the connection that attached it.
statement ok
ATTACH ':memory:' AS dh
  (TYPE duckherder, server_host 'localhost', server_port 8843);

query I
SELECT duckherder_get_client_count();
----
1

statement ok
PRAGMA duckherder_register_remote_table('connection_owned_table', 'connection_owned_table');

statement ok
CREATE TABLE dh.connection_owned_table (id INTEGER);

statement ok
INSERT INTO dh.connection_owned_table VALUES (1);

query I
SELECT count(*) FROM dh.connection_owned_table;
----
1

statement error con1
SELECT count(*) FROM dh.connection_owned_table;
----
<REGEX>:.*read-write Duckherder attachment can only be used by the DuckDB connection that attached it.*

query I
SELECT duckherder_get_client_count();
----
1

statement ok
DETACH dh;

query I
SELECT duckherder_get_client_count();
----
0

# READ_ONLY must be explicit. Every DuckDB connection can then create its own
# read-only Flight registration for the same attachment.
statement ok
ATTACH ':memory:' AS dh
  (TYPE duckherder, client_role 'read_only', server_host 'localhost', server_port 8843);

query I
SELECT duckherder_get_client_count();
----
1

statement ok con1
BEGIN TRANSACTION;

query I con1
SELECT count(*) >= 0 FROM duckherder_get_query_execution_stats();
----
true

query I
SELECT duckherder_get_client_count();
----
2

statement ok con2
BEGIN TRANSACTION;

query I con2
SELECT count(*) >= 0 FROM duckherder_get_query_execution_stats();
----
true

query I
SELECT duckherder_get_client_count();
----
3

statement ok con1
COMMIT;

# The second connection's remote session remains usable after the first one
# completes its independent transaction.
query I con2
SELECT count(*) >= 0 FROM duckherder_get_query_execution_stats();
----
true

statement ok con2
COMMIT;

statement ok
DETACH dh;

query I
SELECT duckherder_get_client_count();
----
0
