# S3 settings for the local RustFS started by `scripts/local-rustfs.sh start`.
export S3_SETUP_SQL="INSTALL cache_httpfs FROM community;
LOAD cache_httpfs;
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER CONFIG, KEY_ID 'rustfsadmin', SECRET 'rustfsadmin',
    REGION 'us-east-1', ENDPOINT '127.0.0.1:19000', USE_SSL false, URL_STYLE 'path');"
