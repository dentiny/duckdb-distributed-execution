# name: test/sql/registration.test
# description: test automatic remote table routing
# group: [sql]

require duckherder

require duckdb_object_storage

statement ok
SELECT duckherder_start_local_server(8822);

statement ok
ATTACH DATABASE 'localhost:8822/database.db' AS dh (TYPE duckherder, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok
USE dh;

statement ok
CREATE TABLE registration_test_table (id INTEGER);

statement ok
INSERT INTO registration_test_table VALUES (42);

query I
SELECT * FROM registration_test_table;
----
42

# Reattaching discovers the existing remote table without a public registration API.
statement ok
USE memory;

statement ok
DETACH dh;

statement ok
ATTACH DATABASE 'localhost:8822/database.db' AS dh (TYPE duckherder, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

query I
SELECT * FROM dh.registration_test_table;
----
42

statement ok
DROP TABLE dh.registration_test_table;

# Automatically registered identifiers follow DuckDB's case-insensitive catalog semantics.
statement ok
CREATE TABLE dh."MixedCase" (value INTEGER);

statement ok
INSERT INTO dh."MixedCase" VALUES (111);

query I
SELECT value FROM dh.mixedcase;
----
111

# Mixed-case DROP follows DuckDB's case-insensitive catalog semantics.
statement ok
DROP TABLE dh.MIXEDCASE;
