# name: test/sql/dml_pushdown.test
# description: Complete DML statements execute on the per-client control-node connection
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8840);

statement ok
ATTACH DATABASE ':memory:' AS dh
  (TYPE duckherder, client_role 'read_write', server_host 'localhost', server_port 8840);

statement ok
PRAGMA duckherder_register_remote_table('dml_source', 'dml_source');

statement ok
PRAGMA duckherder_register_remote_table('dml_target', 'dml_target');

statement ok
CREATE TABLE dh.dml_source (id INTEGER, value VARCHAR);

statement ok
CREATE TABLE dh.dml_target (id INTEGER, value VARCHAR);

statement ok
INSERT INTO dh.dml_source VALUES (1, 'one'), (2, 'two'), (3, 'three');

# The SELECT child is executed by the Control Node, not materialized by the client.
statement ok
INSERT INTO dh.dml_target
SELECT id + 10, upper(value) FROM dh.dml_source WHERE id >= 2;

query II
SELECT id, value FROM dh.dml_target ORDER BY id;
----
12	TWO
13	THREE

statement ok
UPDATE dh.dml_target SET value = value || '_UPDATED' WHERE id = 12;

# Delete forwards the original predicate instead of reconstructing a first-column IN list.
statement ok
DELETE FROM dh.dml_target WHERE value = 'THREE';

query II
SELECT id, value FROM dh.dml_target ORDER BY id;
----
12	TWO_UPDATED

statement ok
BEGIN;

statement ok
UPDATE dh.dml_target SET value = 'ROLLED_BACK' WHERE id = 12;

statement ok
DELETE FROM dh.dml_source WHERE id = 1;

query II
SELECT id, value FROM dh.dml_target ORDER BY id;
----
12	ROLLED_BACK

statement ok
ROLLBACK;

query II
SELECT id, value FROM dh.dml_target ORDER BY id;
----
12	TWO_UPDATED

query II
SELECT id, value FROM dh.dml_source ORDER BY id;
----
1	one
2	two
3	three
