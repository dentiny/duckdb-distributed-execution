# name: test/sql/client_role_reader_metadata.test
# description: read-only attachments discover remote type and table metadata
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8838);

statement ok
ATTACH 'localhost:8838' AS dh
  (TYPE duckherder, client_role 'read_write');

statement ok
CREATE TYPE dh.reader_status AS ENUM ('ready', 'done');

statement ok
CREATE SCHEMA dh.analytics;

statement ok
CREATE TYPE dh.analytics.reader_status AS ENUM ('queued', 'complete');

statement ok
CREATE TABLE dh.reader_visible_data (id INTEGER, status dh.reader_status);

statement ok
INSERT INTO dh.reader_visible_data VALUES (42, 'ready');

statement ok
CREATE TABLE dh.analytics.reader_visible_data (id INTEGER, status dh.analytics.reader_status);

statement ok
INSERT INTO dh.analytics.reader_visible_data VALUES (84, 'queued');

statement ok
CREATE TABLE dh."Order Items" (id INTEGER);

statement ok
INSERT INTO dh."Order Items" VALUES (7);

statement ok
DETACH dh;

statement ok
ATTACH 'localhost:8838' AS dh
  (TYPE duckherder, READ_ONLY);

query IT
SELECT * FROM dh.reader_visible_data;
----
42	ready

query IT
SELECT * FROM dh.analytics.reader_visible_data;
----
84	queued

query I
SELECT * FROM dh."Order Items";
----
7
