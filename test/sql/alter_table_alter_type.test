# name: test/sql/alter_table_alter_type.test
# description: ALTER COLUMN TYPE executes on the control node and updates the client catalog
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8843);

statement ok
ATTACH DATABASE 'localhost:8843' AS dh
  (TYPE duckherder, client_role 'read_write');

statement ok
CREATE TABLE dh.alter_type_test (id INTEGER, value INTEGER);

statement ok
INSERT INTO dh.alter_type_test VALUES (1, 10), (2, 20);

statement ok
ALTER TABLE dh.alter_type_test ALTER COLUMN value TYPE VARCHAR;

statement ok
UPDATE dh.alter_type_test SET value = value || '_updated' WHERE id = 2;

query IT
SELECT id, value FROM dh.alter_type_test ORDER BY id;
----
1	10
2	20_updated
