# name: test/sql/group_by_distributed.test
# description: Test distributed execution with GROUP BY queries
# group: [sql]

require duckherder

require duckdb_object_storage

# Start distributed server with 4 workers
statement ok
SELECT duckherder_start_local_server(8836, 4);

# Attach distributed database
statement ok
ATTACH DATABASE 'localhost:8836/database.db' AS dh (TYPE duckherder, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok
USE dh;

# Tables are registered for distributed access when they are created.
# Create a table with 200,000 rows (enough to trigger distributed execution)
statement ok
CREATE TABLE group_by_table (
    id INTEGER,
    category VARCHAR,
    value INTEGER
);

# Insert 200,000 rows with 3 categories
statement ok
INSERT INTO group_by_table 
SELECT 
    i AS id,
    CASE (i % 3)
        WHEN 0 THEN 'A'
        WHEN 1 THEN 'B'
        ELSE 'C'
    END AS category,
    i * 10 AS value
FROM range(200000) t(i);

statement ok
USE memory;

statement ok
DETACH dh;

statement ok
ATTACH DATABASE 'localhost:8836/database.db' AS dh (TYPE duckherder, READ_ONLY, DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/objfs/{BASE_TEST_NAME}');

statement ok
USE dh;

# Test 1: Verify total row count
query I
SELECT COUNT(*) FROM group_by_table;
----
200000

# Test 2: Verify each category has correct count (simple WHERE, not GROUP BY yet)
query I
SELECT COUNT(*) FROM group_by_table WHERE category = 'A';
----
66667

query I
SELECT COUNT(*) FROM group_by_table WHERE category = 'B';
----
66667

query I
SELECT COUNT(*) FROM group_by_table WHERE category = 'C';
----
66666

# Test 3: Simple aggregation without GROUP BY
query I
SELECT COUNT(*) FROM group_by_table WHERE id > 100000;
----
99999

# Verify distributed execution happened with correct mode
# With 200K rows (2 row groups) and 4 workers, should use ROW_GROUP_PARTITION
query I
SELECT EXISTS(SELECT 1 FROM duckherder_get_query_execution_stats() 
              WHERE sql LIKE '%group_by_table%'
              AND execution_mode = 'ROW_GROUP_PARTITION');
----
true

# Verify only workers with row-group tasks were used
query I
SELECT EXISTS(SELECT 1 FROM duckherder_get_query_execution_stats() 
              WHERE sql LIKE '%group_by_table%'
              AND num_workers_used = 2);
----
true

# Verify one task per row group; a row group is never split across workers
query I
SELECT EXISTS(SELECT 1 FROM duckherder_get_query_execution_stats() 
              WHERE sql LIKE '%group_by_table%'
              AND num_tasks_generated = 2);
----
true
