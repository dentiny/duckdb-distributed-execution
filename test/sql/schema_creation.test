# name: test/sql/schema_creation.test
# description: create and drop schemas on the remote Duckherder catalog
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(8849);

statement ok
ATTACH 'localhost:8849' AS dh (TYPE duckherder, client_role 'read_write');

query I
SELECT count(*) FROM duckdb_schemas()
WHERE database_name = 'dh' AND schema_name = 'main' AND internal;
----
1

statement ok
CREATE SCHEMA dh."Analytics";

statement error
CREATE VIEW dh.analytics.local_view AS SELECT 42;
----
<REGEX>:.*CREATE VIEW is not supported by Duckherder catalogs.*

statement error
CREATE SEQUENCE dh.analytics.local_sequence;
----
<REGEX>:.*CREATE SEQUENCE is not supported by Duckherder catalogs.*

statement ok
BEGIN;

statement ok
CREATE SCHEMA dh.rollback_schema;

statement ok
CREATE TABLE dh.rollback_schema.rollback_table (id INTEGER);

statement ok
ROLLBACK;

statement ok
CREATE SCHEMA dh.rollback_schema;

statement ok
DROP SCHEMA dh.rollback_schema;

statement ok
CREATE TABLE dh.analytics.events (id INTEGER);

statement ok
CREATE SCHEMA IF NOT EXISTS dh.ANALYTICS;

statement error
CREATE SCHEMA dh.analytics;
----
<REGEX>:.*Schema with name "analytics" already exists.*

statement ok
INSERT INTO dh.analytics.events VALUES (42);

statement ok
CREATE INDEX events_id_idx ON dh.analytics.events (id);

statement ok
DROP INDEX dh.analytics.events_id_idx;

statement ok
ALTER TABLE dh.analytics.events RENAME TO archived_events;

statement ok
BEGIN;

statement ok
DROP SCHEMA dh.analytics CASCADE;

statement ok
ROLLBACK;

query I
SELECT * FROM dh.analytics.archived_events;
----
42

statement error
DROP SCHEMA dh.analytics;
----
<REGEX>:.*Cannot drop entry "Analytics" because there are entries that depend on it.*

statement ok
DROP SCHEMA dh.analytics CASCADE;

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'dh' AND schema_name = 'analytics';
----
0
