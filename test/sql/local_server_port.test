# name: test/sql/local_server_port.test
# description: The local server can use a port in the range local workers pick their ports from
# group: [sql]

require duckherder

statement ok
SELECT duckherder_start_local_server(9000, 2);

statement ok
ATTACH 'localhost:9000' AS dh (TYPE duckherder);

statement ok
CREATE TABLE dh.t AS SELECT i FROM range(10) t(i);

query I
SELECT sum(i) FROM dh.t;
----
45
