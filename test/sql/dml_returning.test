# name: test/sql/dml_returning.test
# description: Remote DML returns rows produced by a RETURNING clause
# group: [sql]

# FIXME: ExecuteSQLResponse currently carries only status and affected-row metadata.
# Enable this regression after DML result rows are streamed back from the Control Node.
mode skip

require duckherder

statement ok
SELECT duckherder_start_local_server(8841);

statement ok
ATTACH DATABASE 'localhost:8841' AS dh
  (TYPE duckherder, client_role 'read_write');

statement ok
CREATE TABLE dh.dml_returning (id INTEGER, value VARCHAR);

query II
INSERT INTO dh.dml_returning VALUES (1, 'one') RETURNING id, value;
----
1	one
